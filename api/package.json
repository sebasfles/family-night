    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@family-night/shared": "workspace:*",
    "@hono/aws-lambda": "^1.0.1",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@smithy/types": "^4.19.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/aws-lambda": "^8.10.164",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3"
  }
